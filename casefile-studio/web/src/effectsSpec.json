      "tint": null
    },
    {
      "id": "sepia",
      "label": "Sepia",
      "ffmpeg": "colorchannelmixer=.393:.769:.189:0:.349:.686:.168:0:.272:.534:.131",
      "css": "sepia(1)",
      "tint": null
    },
    {
      "id": "faded",
      "label": "Faded film",
      "ffmpeg": "eq=contrast=0.85:brightness=0.04:saturation=0.75",
      "css": "contrast(0.85) brightness(1.06) saturate(0.75)",
      "tint": null
